// Engnova — Prisma schema
// Generator + datasource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Skill {
  VOCABULARY
  GRAMMAR
  READING
  LISTENING
  SPEAKING
}

enum LessonType {
  GRAMMAR
  READING
  LISTENING
  SPEAKING
}

// ---------- Auth (NextAuth.js / Auth.js v5) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile      Profile?
  accounts     Account[]
  sessions     Session[]
  progress     UserProgress[]
  savedWords   SavedWord[]
  quizAttempts QuizAttempt[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Profile & progress ----------

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  level         Level    @default(BEGINNER)
  dailyGoal     Int      @default(20) // minutes per day
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveOn  DateTime?
  bio           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  skill       Skill
  lessonId    String?
  score       Int      @default(0) // 0..100
  minutes     Int      @default(0)
  completedAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userId, skill])
  @@index([userId, completedAt])
}

// ---------- Content ----------

model Vocabulary {
  id            String   @id @default(cuid())
  word          String   @unique
  meaning       String
  meaningKh     String?
  example       String?
  pronunciation String?
  partOfSpeech  String?
  level         Level    @default(BEGINNER)
  audioUrl      String?
  createdAt     DateTime @default(now())

  savedBy SavedWord[]
}

model SavedWord {
  id           String   @id @default(cuid())
  userId       String
  vocabularyId String
  note         String?
  savedAt      DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyId])
}

model Lesson {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  type        LessonType
  level       Level      @default(BEGINNER)
  summary     String
  content     String // markdown / HTML
  audioUrl    String?
  transcript  String?
  highlight   Json // words to highlight (reading), e.g. ["curious","diligent"]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  quizzes  Quiz[]
  progress UserProgress[]
}

// ---------- Quizzes ----------

model Quiz {
  id          String   @id @default(cuid())
  title       String
  description String?
  skill       Skill
  level       Level    @default(BEGINNER)
  lessonId    String?
  createdAt   DateTime @default(now())

  lesson    Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id        String  @id @default(cuid())
  quizId    String
  prompt    String
  // For reading/listening questions, optional supporting context
  context   String?
  position  Int     @default(0)

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([quizId])
}

model Answer {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  position   Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Int      @default(0) // raw correct count
  total       Int      @default(0)
  percentage  Int      @default(0) // 0..100
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
}
